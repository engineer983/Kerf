{
  "name": "kerf",
  "private": true,
  "version": "1.0.0-rc.2",
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "wasm": "wasm-pack build crates/kerf-web --target web --release --no-pack --out-dir ../../src/web/pkg",
    "dev:web": "pnpm wasm && vite --mode web",
    "build:web": "pnpm wasm && tsc --noEmit -p tsconfig.web.json && vite build --mode web",
    "preview:web": "vite preview --mode web --outDir dist-web --port 1422",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "@fontsource-variable/jetbrains-mono": "^5.2.0",
    "@huggingface/transformers": "^4.3.1",
    "@tauri-apps/api": "^2.0.0",
    "lucide-react": "^0.500.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.170.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "wasm-pack": "^0.15.0"
  }
}
